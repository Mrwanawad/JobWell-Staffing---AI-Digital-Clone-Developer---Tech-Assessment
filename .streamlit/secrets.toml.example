# Template. Copy to secrets.toml and fill in real values.
#
# Local:  cp .streamlit/secrets.toml.example .streamlit/secrets.toml
# Cloud:  paste these three lines into the app's Secrets box, with real values.
#
# TOML, not .env: values need quotes and there are spaces around the equals sign.

LLM_BACKEND = "gemini"
GEMINI_API_KEY = "your-key-from-aistudio.google.com/apikey"
GEMINI_MODEL_ID = "your-gemini-model-id"
